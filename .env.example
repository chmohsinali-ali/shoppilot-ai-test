# ===== Application =====
NODE_ENV=production
PORT=5173
APP_NAME=ShopPilot AI
APP_URL=http://localhost:5173
WEB_URL=http://localhost:5173
API_URL=http://localhost:5173

# ===== Supabase (required) =====
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===== AI Provider (optional — add to enable AI assistant) =====
# Uses any OpenAI-compatible API (OpenAI, Groq, Together, OpenRouter, etc.)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ===== Voice transcription (reuses AI_API_KEY / AI_BASE_URL above) =====
# Requires an OpenAI-compatible /audio/transcriptions endpoint (Whisper).
# Set as Supabase Edge Function secrets alongside the AI_* vars above.
AI_STT_MODEL=whisper-1
AI_STT_TIMEOUT_MS=30000

# ===== Defaults =====
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_LOCALE=en-PK
LOG_LEVEL=info
